@model ERP.Web.Service.ViewModels.ExamSearchListViewModel_result
<partial name="~/Views/Exam/_ExamContext.cshtml" />
@{
    var examSubjectLabel = ViewData["ExamSubjectLabel"]?.ToString() ?? "英文";
    var isMathExam = ViewData["ExamIsMath"] as bool? == true;
}

<link href="~/css/exam.css" rel="stylesheet" />
<link href="~/StaticFiles/lib/select2/dist/css/select2.css" rel="stylesheet" />
<link href="~/StaticFiles/lib/select2/dist/css/select2-bootstrap.css" rel="stylesheet" />

<!-- 單純出考卷：選考卷 / 題數 / 學生，送出即產生考卷 -->
<div class="wrapper wrapper-content animated fadeIn">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox">
                <div class="ibox-title">
                    <h5>出考卷 — @examSubjectLabel</h5>
                    @if (isMathExam)
                    {
                        <span class="badge bg-info ms-2">數學</span>
                    }
                    else
                    {
                        <span class="badge bg-primary ms-2">英文</span>
                    }
                </div>
                <div class="ibox-content">
                    <div class="mb-3">
                        <a class="btn btn-secondary btn-sm" href="@Url.Action("Index","ExamUpload")">上傳題目</a>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-end gap-3">
                                <div>
                                    <span class="badge bg-warning text-dark">複習考</span>
                                </div>
                                <div>
                                    <label class="form-label mb-1" for="WrongTestNumber">筆試題數</label>
                                    <input id="WrongTestNumber" type="number" class="form-control" value="18" min="1" style="width:120px;" />
                                </div>
                                @if (!isMathExam)
                                {
                                    <div>
                                        <label class="form-label mb-1" for="WrongEnglishListeningCount">英聽題數</label>
                                        <input id="WrongEnglishListeningCount" type="number" class="form-control" value="7" min="0" style="width:120px;" title="聽英文 → 寫中文" />
                                    </div>
                                    <div>
                                        <label class="form-label mb-1" for="WrongChineseListeningCount">中聽題數</label>
                                        <input id="WrongChineseListeningCount" type="number" class="form-control" value="3" min="0" style="width:120px;" title="聽中文 → 寫英文" />
                                    </div>
                                }
                                <div class="d-flex flex-column gap-2">
                                    <button id="btnWrongTest" type="button" class="btn btn-warning">
                                        複習考（筆試）
                                    </button>
                                    @if (!isMathExam)
                                    {
                                        <button id="btnListeningWrongTest" type="button" class="btn btn-info btn-sm">
                                            複習考（聽力版本）
                                        </button>
                                    }
                                </div>
                                <div class="text-muted small">
                                    依「學生」自動抓歷史@examSubjectLabel答錯（Correct=0）的題目組卷（不限定日期）。
                                    @if (!isMathExam)
                                    {
                                        <span>聽力版本以英聽／中聽題數為準，並含答案卷。</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <partial name="~/Views/Exam/_GetTest.cshtml" model="Model" />
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/StaticFiles/lib/select2/dist/js/select2.min.js"></script>
<script>
    // 套用 Select2 到「選擇考卷」下拉，避免原生 multiple 撐版
    $(function () {
        var $select2ClassList = $('#Select2ClassNameList');
        if ($select2ClassList.length) {
            $select2ClassList.select2({
                placeholder: '選擇考卷',
                allowClear: true,
                closeOnSelect: false,
                width: '100%'
            });
        }

        // 複習考：筆試版本
        $('#btnWrongTest').on('click', function () {
            var kidId = $('#KidID').val();
            var testNumber = $('#WrongTestNumber').val() || 18;

            if (!kidId) {
                alert('請先選擇學生');
                return;
            }

            var url = '@Url.Action("WrongTest", ViewContext.RouteData.Values["controller"]?.ToString())'
                + '?KidID=' + encodeURIComponent(kidId)
                + '&TestNumber=' + encodeURIComponent(testNumber);

            window.location.href = url;
        });

        // 複習考：聽力版本（英聽＋中聽，含答案卷）
        $('#btnListeningWrongTest').on('click', function () {
            var kidId = $('#KidID').val();
            var en = parseInt($('#WrongEnglishListeningCount').val(), 10) || 0;
            var zh = parseInt($('#WrongChineseListeningCount').val(), 10) || 0;

            if (!kidId) {
                alert('請先選擇學生');
                return;
            }
            if (en + zh <= 0) {
                alert('請至少設定 1 題英聽或中聽題數');
                return;
            }

            var url = '@Url.Action("ListeningWrongTest", ViewContext.RouteData.Values["controller"]?.ToString())'
                + '?KidID=' + encodeURIComponent(kidId)
                + '&EnglishListeningCount=' + encodeURIComponent(en)
                + '&ChineseListeningCount=' + encodeURIComponent(zh);

            window.location.href = url;
        });
    });
</script>
