@model ERP.Web.Service.ViewModels.ExamDataViewModel_result

@{
    Layout = null;  // 禁用布局
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    /* 考卷格式（10 題單頁排版） */
    .exam-container {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        font-size: 16px;
        line-height: 1.35;
    }

    .question-number {
        font-weight: bold;
    }

    .question-text {
        font-size: 16px;
    }

    /* 單字／片語題目區塊：縮小上下間距 */
    .exam-container .question-row {
        margin-top: 0.2rem;
        margin-bottom: 0.2rem;
    }

    .exam-container .answer-row {
        margin-top: 0.15rem;
        margin-bottom: 0.35rem;
    }

    /* 三條書寫線：固定於 1/3、2/3、3/3 位置平均分布（勿用 repeating，否則會多出線條） */
    .answer-line {
        display: block;
        width: 100%;
        height: 45px;
        font-size: 16px;
        padding: 6px 10px;
        border: 1px solid #e9e4e4;
        background-image: linear-gradient(
            to bottom,
            transparent calc(100% / 3 - 1px),
            #e9e4e4 calc(100% / 3 - 1px),
            #e9e4e4 calc(100% / 3),
            transparent calc(100% / 3),
            transparent calc(200% / 3 - 1px),
            #e9e4e4 calc(200% / 3 - 1px),
            #e9e4e4 calc(200% / 3),
            transparent calc(200% / 3),
            transparent calc(100% - 1px),
            #e9e4e4 calc(100% - 1px),
            #e9e4e4 100%
        );
        background-repeat: no-repeat;
        background-size: 100% 100%;
        box-sizing: border-box;
        outline: none;
    }

    .answer-text {
        position: relative;
        top: 4px; /* 對齊縮小後的書寫線 */
        display: inline-block;
        font-size: 15px;
    }
    /* 強制換頁 */
    .page-break {
        page-break-before: always;
    }

    /* 提交按鈕置中 */
    .submit-container {
        text-align: center;
        margin-top: 30px;
    }

    .exam-title {
        font-size: 14px;
        margin-top: 8px;
        margin-bottom: 8px;
        font-weight: bold;
    }

    .exam-section {
        font-size: 14px;
        margin-top: 8px;
        margin-bottom: 8px;
        font-weight: bold;
    }

    /* 列印：10 題單字／片語卷再壓縮，避免溢到第二頁 */
    @@media print {
        @@page {
            margin: 10mm 12mm;
        }

        .exam-container:not(.page-break) {
            font-size: 18px;
            line-height: 1.3;
            max-width: 100%;
            page-break-inside: avoid;
        }

        .question-text {
            font-size: 18px;
        }

        .exam-container .question-row {
            margin-top: 0.1rem;
            margin-bottom: 0.1rem;
        }

        .exam-container .answer-row {
            margin-top: 0.1rem;
            margin-bottom: 0.25rem;
        }

        .answer-line {
            height: 56px;
            font-size: 22px;
            padding: 5px 8px;
        }

        .answer-text {
            font-size: 22px;
            top: 6px;
        }

        .exam-title,
        .exam-section {
            font-size: 13px;
            margin-top: 4px;
            margin-bottom: 4px;
        }
    }

</style>
@Html.Raw(@"
    <style>
        @media print {
            .page-break {
                display: block !important;
                page-break-after: always;
                break-after: page;
            }
        }
    </style>
")

<form method="post" id="TestView" action="@Url.Action("Submit", "Exam")">
    @{
        var words = Model.VocabularyList.Where(x => x.CategoryType == "Word").ToList();
        var phrases = Model.VocabularyList.Where(x => x.CategoryType == "Phrase").ToList();
    }

    @if (words.Any() || phrases.Any())
    {
        <div class="exam-container">
            <div style="display: flex; justify-content: space-between;">
                <label class="exam-title">
                    @Model.Title @Model.ExamPaperSuffix
                </label>
                <label class="exam-section mt-4">
                    姓名:_________________________
                </label>
            </div>

            @if (words.Any())
            {
                <div class="exam-section">單字測驗 (寫出中文所代表的意思) 每題 @Model.scoreTable.WordScore 分</div>
                @for (int i = 0; i < words.Count; i++)
                {
                    <div class="question-row">
                        <span class="question-number">@(i + 1).</span>
                        <span class="question-text">@words[i].Question</span>
                    </div>
                    <div class="answer-row">
                        <input type="text" class="answer-line" name="answers[@i]" required />
                    </div>
                }
            }

            @if (phrases.Any())
            {
                <div class="exam-section">片語測驗 (寫出對應的問句或回答) 每題 @Model.scoreTable.PhraseScore 分</div>
                @for (int i = 0; i < phrases.Count; i++)
                {
                    <div class="question-row">
                        <span class="question-number">@(words.Count + i + 1).</span>
                        <span class="question-text">@phrases[i].Question</span>
                    </div>
                    <div class="answer-row">
                        <input type="text" class="answer-line" name="answers[@(words.Count + i)]" required />
                    </div>
                }
            }
        </div>

        <!-- 答案卷 -->
        <div class="exam-container page-break">
            <div style="display: flex; justify-content: space-between;">
                <label class="exam-title">
                    @($"{Model.Title} {Model.ExamTypeLabel}答案卷_{Model.ExamDate:yyyyMMdd}_{Model.ExamAttemptNumber}")
                </label>
            </div>

            @if (words.Any())
            {
                <div class="exam-section">單字測驗答案</div>
                @for (int i = 0; i < words.Count; i++)
                {
                    <div class="question-row">
                        <span class="question-number">@(i + 1).</span>
                        <span class="question-text">@words[i].Question</span>
                    </div>
                    <div class="answer-line answer-row">
                        <span class="answer-text">@words[i].Answer</span>
                    </div>
                }
            }

            @if (phrases.Any())
            {
                <div class="exam-section">片語測驗答案</div>
                @for (int i = 0; i < phrases.Count; i++)
                {
                    <div class="question-row">
                        <span class="question-number">@(words.Count + i + 1).</span>
                        <span class="question-text">@phrases[i].Question</span>
                    </div>
                    <div class="answer-line answer-row">
                        <span class="answer-text">@phrases[i].Answer</span>
                    </div>
                }
            }
        </div>
    }

</form>


