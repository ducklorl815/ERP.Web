@model ERP.Web.Service.ViewModels.ExamDataViewModel_result
@using System.Text.Json

@{
    Layout = null;
    // 與英聽音檔播放順序一致：依 VocabularyList 出題順序，不拆分單字／片語
    var questions = Model.VocabularyList ?? new List<ERP.Web.Models.Models.Vocabulary>();
    var tracksByQuestion = (Model.ExamListeningTracks ?? new List<ERP.Web.Service.ViewModels.ExamListeningTrackViewModel>())
        .ToDictionary(t => t.QuestionNumber);
    var trackUrlsJson = JsonSerializer.Serialize(
        (Model.ExamListeningTracks ?? new List<ERP.Web.Service.ViewModels.ExamListeningTrackViewModel>())
            .OrderBy(t => t.QuestionNumber)
            .Select(t => t.AudioUrl));
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    .exam-container {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        font-size: 16px;
        line-height: 1.35;
    }

    .question-number { font-weight: bold; }

    .question-text {
        font-size: 16px;
    }

    .exam-container .question-row {
        margin-top: 0.2rem;
        margin-bottom: 0.2rem;
    }

    .exam-container .answer-row {
        margin-top: 0.15rem;
        margin-bottom: 0.35rem;
    }

    .answer-line {
        display: block;
        width: 100%;
        height: 45px;
        font-size: 16px;
        padding: 6px 10px;
        border: 1px solid #e9e4e4;
        background-image: linear-gradient(
            to bottom,
            transparent calc(100% / 3 - 1px),
            #e9e4e4 calc(100% / 3 - 1px),
            #e9e4e4 calc(100% / 3),
            transparent calc(100% / 3),
            transparent calc(200% / 3 - 1px),
            #e9e4e4 calc(200% / 3 - 1px),
            #e9e4e4 calc(200% / 3),
            transparent calc(200% / 3),
            transparent calc(100% - 1px),
            #e9e4e4 calc(100% - 1px),
            #e9e4e4 100%
        );
        background-repeat: no-repeat;
        background-size: 100% 100%;
        box-sizing: border-box;
        outline: none;
    }

    .answer-text {
        position: relative;
        top: 4px;
        display: inline-block;
        font-size: 15px;
    }

    .page-break { page-break-before: always; }

    .exam-title {
        font-size: 14px;
        margin-top: 8px;
        margin-bottom: 8px;
        font-weight: bold;
    }

    .exam-section {
        font-size: 14px;
        margin-top: 8px;
        margin-bottom: 8px;
        font-weight: bold;
    }

    /* 英聽：螢幕預覽用音檔區（列印時隱藏） */
    .listening-preview {
        margin: 0.25rem 0 0.5rem 1.5rem;
    }

    .listening-preview audio {
        max-width: 100%;
        height: 32px;
    }

    .listening-play-all {
        margin: 0.25rem 0 0.75rem 0;
    }

    .listening-play-all audio {
        width: 100%;
        max-width: 600px;
        height: 32px;
    }

    .tts-notice {
        background: #fff3cd;
        border: 1px solid #ffecb5;
        border-radius: 6px;
        padding: 10px 14px;
        margin-bottom: 1rem;
        font-size: 14px;
    }

    .tts-item-error {
        color: #856404;
        font-size: 12px;
    }

    .no-print { }

    @@media print {
        @@page { margin: 10mm 12mm; }

        .no-print { display: none !important; }

        .exam-container:not(.page-break) {
            font-size: 18px;
            line-height: 1.3;
            max-width: 100%;
            page-break-inside: avoid;
        }

        .exam-container .question-row {
            margin-top: 0.1rem;
            margin-bottom: 0.1rem;
        }

        .exam-container .answer-row {
            margin-top: 0.1rem;
            margin-bottom: 0.25rem;
        }

        .answer-line {
            height: 56px;
            font-size: 22px;
            padding: 5px 8px;
        }

        .answer-text {
            font-size: 22px;
            top: 6px;
        }

        .exam-title,
        .exam-section {
            font-size: 13px;
            margin-top: 4px;
            margin-bottom: 4px;
        }
    }
</style>

@Html.Raw(@"
    <style>
        @media print {
            .page-break {
                display: block !important;
                page-break-after: always;
                break-after: page;
            }
        }
    </style>
")

@if (Model.ExamListeningTracks?.Any() == true)
{
    <div class="exam-container listening-playlist no-print mb-3">
        <div class="exam-section">英聽音檔（每題獨立：第 N 題 → 單字 ×2，含間隔）</div>
        <div class="listening-play-all">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <button type="button" class="btn btn-sm btn-primary" id="btn-play-all-tracks">依序播放全部</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-stop-all-tracks">停止</button>
                <span class="text-muted small" id="play-all-status"></span>
            </div>
            <audio id="listening-play-all" controls preload="metadata"></audio>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.TtsNoticeMessage))
{
    <div class="exam-container tts-notice no-print">
        @Model.TtsNoticeMessage
    </div>
}

<form method="post" id="TestView" action="@Url.Action("Submit", "Exam")">
    @if (questions.Any())
    {
        <div class="exam-container">
            <div style="display: flex; justify-content: space-between;">
                <label class="exam-title">
                    @Model.Title @Model.ExamPaperSuffix
                </label>
                <label class="exam-section mt-4">
                    姓名:_________________________
                </label>
            </div>

            <p class="exam-section no-print text-muted small mb-2">
                聽力預覽：每題可單獨播放或重播；上方「依序播放全部」會依題號播放各題音檔。列印考卷僅顯示題號。
            </p>

            <div class="exam-section">聽力測驗（聽音後寫出答案）</div>
            @for (int i = 0; i < questions.Count; i++)
            {
                var item = questions[i];
                var questionNumber = i + 1;
                tracksByQuestion.TryGetValue(questionNumber, out var track);
                var score = string.Equals(item.CategoryType, "Phrase", StringComparison.OrdinalIgnoreCase)
                    ? Model.scoreTable.PhraseScore
                    : Model.scoreTable.WordScore;
                <div class="question-row">
                    <span class="question-number">@(questionNumber).</span>
                    <span class="listening-q-label">（聽音作答，@(string.Equals(item.CategoryType, "Phrase", StringComparison.OrdinalIgnoreCase) ? "片語" : "單字") @score 分）</span>
                </div>
                @if (track != null)
                {
                    <div class="listening-preview no-print">
                        <audio controls preload="metadata"
                               src="@track.AudioUrl"
                               data-question-number="@questionNumber"
                               class="question-audio"></audio>
                        <a class="btn btn-sm btn-outline-primary ms-2"
                           href="@track.AudioUrl"
                           download="@track.DownloadName">下載</a>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary ms-1 btn-replay-question"
                                data-question-number="@questionNumber">重播此題</button>
                    </div>
                }
                else if (!string.IsNullOrEmpty(item.TtsErrorMessage))
                {
                    <div class="listening-preview no-print tts-item-error">@item.TtsErrorMessage</div>
                }
                <div class="answer-row">
                    <input type="text" class="answer-line" name="answers[@i]" />
                </div>
            }
        </div>

        <!-- 答案卷：題號、聽力類型、念出的題目、正確答案，順序與音檔一致 -->
        <div class="exam-container page-break">
            <div style="display: flex; justify-content: space-between;">
                <label class="exam-title">
                    @($"{Model.Title} {Model.ExamTypeLabel}答案卷_{Model.ExamDate:yyyyMMdd}_{Model.ExamAttemptNumber}")
                </label>
            </div>

            <div class="exam-section">聽力測驗答案</div>
            @for (int i = 0; i < questions.Count; i++)
            {
                var item = questions[i];
                var expected = item.ListeningExpectedAnswer ?? item.Answer;
                var isEnglishListening = string.Equals(item.ListeningDirection, "English", StringComparison.OrdinalIgnoreCase);
                var dirLabel = isEnglishListening ? "英聽" : "中聽";
                var speakText = !string.IsNullOrWhiteSpace(item.SpeakText)
                    ? item.SpeakText
                    : isEnglishListening
                        ? item.Answer
                        : item.Question;
                <div class="question-row">
                    <span class="question-number">@(i + 1).</span>
                    <span class="text-muted small">（@dirLabel）</span>
                    <span class="question-text">@speakText</span>
                </div>
                <div class="answer-line answer-row">
                    <span class="answer-text">@expected</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="exam-container p-4">
            <p class="text-muted mb-0">尚無題目可出英聽考卷，請先選擇考卷、學生與題數。</p>
        </div>
    }
</form>

@if (Model.ExamListeningTracks?.Any() == true)
{
    <script>
        (function () {
            const trackUrls = @Html.Raw(trackUrlsJson);
            const playAllPlayer = document.getElementById('listening-play-all');
            const playAllBtn = document.getElementById('btn-play-all-tracks');
            const stopAllBtn = document.getElementById('btn-stop-all-tracks');
            const playAllStatus = document.getElementById('play-all-status');
            let playAllIndex = 0;

            function updatePlayAllStatus() {
                if (!playAllStatus) return;
                if (playAllIndex >= trackUrls.length) {
                    playAllStatus.textContent = '播放完成';
                    return;
                }
                playAllStatus.textContent = `正在播放第 ${playAllIndex + 1} / ${trackUrls.length} 題`;
            }

            function playAllNext() {
                if (!playAllPlayer || playAllIndex >= trackUrls.length) {
                    updatePlayAllStatus();
                    return;
                }

                playAllPlayer.src = trackUrls[playAllIndex];
                playAllPlayer.play().catch(function () { /* 使用者手動停止 */ });
                updatePlayAllStatus();
            }

            if (playAllPlayer) {
                playAllPlayer.addEventListener('ended', function () {
                    playAllIndex++;
                    if (playAllIndex < trackUrls.length) {
                        playAllNext();
                    } else {
                        updatePlayAllStatus();
                    }
                });
            }

            if (playAllBtn) {
                playAllBtn.addEventListener('click', function () {
                    playAllIndex = 0;
                    playAllNext();
                });
            }

            if (stopAllBtn && playAllPlayer) {
                stopAllBtn.addEventListener('click', function () {
                    playAllPlayer.pause();
                    playAllPlayer.currentTime = 0;
                    playAllIndex = trackUrls.length;
                    if (playAllStatus) playAllStatus.textContent = '已停止';
                });
            }

            document.querySelectorAll('.btn-replay-question').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const questionNumber = btn.getAttribute('data-question-number');
                    const audio = document.querySelector('.question-audio[data-question-number="' + questionNumber + '"]');
                    if (!audio) return;
                    audio.currentTime = 0;
                    audio.play().catch(function () { /* 使用者手動停止 */ });
                });
            });
        })();
    </script>
}
